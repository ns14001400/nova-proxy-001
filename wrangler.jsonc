{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-001",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ecd0cdcc-b869-4e41-bbeb-a5b20349fffe","database_name": "nova-proxy_001" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6120ea318b334aa5a90049dd57536367" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
